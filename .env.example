# QuantLab — variables de entorno (SIN valores reales)
# Copiar a .env y completar. .env está en .gitignore.

QUANTLAB_A3_USER=
QUANTLAB_A3_PASSWORD=
QUANTLAB_A3_ACCOUNT=
QUANTLAB_A3_TOKEN=

# Nunca "I_UNDERSTAND_THIS_SENDS_REAL_ORDERS" en CI
QUANTLAB_ENABLE_LIVE_TRADING=DISABLED

# Opt-in a tests de simulación reMarkets
QUANTLAB_RUN_A3_SIMULATION_TESTS=0

# —— Chat IA (Fase 22) — placeholders DISABLED; sin secretos ——
# CI/default usa FakeProvider (offline, pattern-match ES).
# OptionalEnvProvider solo si QUANTLAB_LLM_API_KEY != DISABLED (NO en tests CI).
QUANTLAB_LLM_API_KEY=DISABLED
QUANTLAB_LLM_BASE_URL=
QUANTLAB_LLM_MODEL=
QUANTLAB_LLM_PROVIDER=fake
