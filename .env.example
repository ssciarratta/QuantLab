# QuantLab — variables de entorno (SIN valores reales)
# Copiar a .env y completar. .env está en .gitignore.

QUANTLAB_A3_USER=
QUANTLAB_A3_PASSWORD=
QUANTLAB_A3_ACCOUNT=
QUANTLAB_A3_TOKEN=

# A3 MD read-only opt-in (Fase 24). Requiere =1 + QUANTLAB_A3_* para backend env.
# Sin flag/creds → fallback fake. submit/cancel siguen LIVE_BLOCKED.
QUANTLAB_A3_MD_READONLY=0
# QUANTLAB_A3_ENVIRONMENT=simulation

# CSV MD genérico (venue generic_csv); vacío → filas demo in-memory
# QUANTLAB_GENERIC_CSV_PATH=

# Data Catalog browser (F30) — path opcional a SQLite/DuckDB local.
# Default: data/catalog/quantlab_catalog.sqlite (si existe). Sin archivo → lista vacía.
# QUANTLAB_CATALOG_PATH=

# Nunca "I_UNDERSTAND_THIS_SENDS_REAL_ORDERS" en CI
QUANTLAB_ENABLE_LIVE_TRADING=DISABLED

# Opt-in a tests de simulación reMarkets
QUANTLAB_RUN_A3_SIMULATION_TESTS=0

# —— Chat IA (Fase 22 / F113 asistente con memoria) ——
# CI/default: FakeProvider offline (sin key).
# Con key: NVIDIA / Gemini / OpenAI (todos OpenAI-compatible).
#
# Opción A — Gemini gratis (recomendada):
#   1) https://aistudio.google.com/apikey  → Create API key
#   2) QUANTLAB_LLM_PROVIDER=gemini
#   3) QUANTLAB_LLM_API_KEY=tu_key
#
# Opción B — NVIDIA NIM (gratis con cuenta build.nvidia.com):
#   1) https://build.nvidia.com → Get API Key
#   2) QUANTLAB_LLM_PROVIDER=nvidia
#   3) QUANTLAB_LLM_API_KEY=tu_key
#
# Opción C — OpenAI:
#   QUANTLAB_LLM_PROVIDER=openai
#   QUANTLAB_LLM_API_KEY=sk-...
#
QUANTLAB_LLM_API_KEY=DISABLED
QUANTLAB_LLM_PROVIDER=gemini
# Dejá vacío para usar el preset del provider (gemini/nvidia/openai)
QUANTLAB_LLM_BASE_URL=
QUANTLAB_LLM_MODEL=
# Modelos tip: gemini-2.0-flash | meta/llama-3.1-70b-instruct | gpt-4o-mini

# —— Fees Binance Spot (lab/backtest) ——
# Default: VIP0 0.10% maker/taker (schedule publicado, sin asumir BNB).
# =1 → aplica descuento BNB (−25% → 0.075%).
# QUANTLAB_BINANCE_FEE_BNB_DISCOUNT=0
